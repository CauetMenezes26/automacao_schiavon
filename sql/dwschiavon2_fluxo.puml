@startuml dwschiavon2_FLUXO
' =============================================================================
' FLUXO — dwschiavon2
' Coluna unica, de cima para baixo: em que ordem cada tabela e preenchida.
' Nada de ramos lado a lado — o diagrama tem que caber na largura da tela.
' =============================================================================

title Como cada tabela é preenchida — dwschiavon2

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #5B6058
skinparam ArrowFontColor #5B6058
skinparam activity {
  BorderColor #5B6058
  FontColor #1F2421
  DiamondBackgroundColor #F4F3EF
  DiamondBorderColor #8B9088
  DiamondFontSize 12
}
skinparam partition {
  BorderColor #1E2B3C
  FontColor #1E2B3C
}

start

partition "**0 · CADASTRO**  (uma vez, na mão)" {
  #F6EDDD:**dim_loja**
  Windermere · Dr. Phillips;

  #F6EDDD:**dim_fonte**
  URL do SharePoint, por loja;

  #F6EDDD:**dim_fornecedor**
  quem cota e quem fatura;

  #F6EDDD:**dim_fornecedor_alias**
  de-para do nome lido no PDF
  <i>hoje 184 de 189 notas não casam</i>;
}

partition "**1 · COTAÇÃO**  (semanal)" {
  #FFF8E8:**21 · ABRIR_CICLO**
  + **processo**   cotacao / 2026-W26
  + **dim_ciclo**  semana, início, fim
  <i>EM_ANDAMENTO · 20%</i>;

  #FFF8E8:**22 · PUBLICAR_PLANILHA**
  cria a coluna da semana no Excel
  + **fat_cotacao_envio**
  <i>EM_ANDAMENTO · 40%</i>;

  #FFF8E8:**23 · NOTIFICAR**
  ~ **fat_cotacao_envio**  enviado_em, sid
  <i>EM_ANDAMENTO · 60%</i>;

  #FFF8E8:**24 · AGUARDAR_RESPOSTA**
  <i>AGUARDANDO_RESPOSTA (12) · 80%</i>;

  if (respondeu?) then (não, venceu o prazo)
    #FFF8E8:+ **fat_cotacao_cobranca**;
    detach
  else (sim)
  endif

  #FFF8E8:**25 · IMPORTAR_PRECOS**
  lê a coluna preenchida
  ~ **fat_cotacao_envio**  importado_em
  + **fat_cotacao_preco**  um por item
  <i>**FINALIZADO** (0) · 100%</i>;
}

partition "**2 · NOTA**  (a cada coleta)" {
  #EDF3F7:**11 · COLETAR**
  baixa o PDF do SharePoint
  + **processo**  invoice / nome do arquivo
  <i>EM_ANDAMENTO · 25%</i>;

  #EDF3F7:**12 · LER**
  Claude Vision extrai o documento
  + **fat_invoice**       cabeçalho
  + **fat_invoice_item**  uma por linha
  <i>tipo_linha: item | encargo | ajuste</i>
  <i>EM_ANDAMENTO · 50%</i>;

  #EDF3F7:**13 · IDENTIFICAR_FORNECEDOR**
  busca em **dim_fornecedor_alias**
  ~ **fat_invoice**  id_fornecedor
  <i>EM_ANDAMENTO · 75%</i>;

  if (achou?) then (não)
    #F7E9E5:<i>ERRO_SEM_FORNECEDOR (55) · 50%</i>
    para aqui, mas fica registrado;
    detach
  else (sim)
  endif
}

partition "**3 · CONCILIAÇÃO**  (onde os dois se encontram)" {
  #F7E9E5:**14 · CONCILIAR_COTACAO**
  acha o ciclo da semana da nota
  + **fat_conciliacao**       uma por nota
  + **fat_conciliacao_item**  só tipo_linha = item
  <i>dif_valor = dif_unitária × qtd</i>
  <i>**FINALIZADO** (0) · 100%</i>
  <i>ou FINALIZADO_COM_ALERTA (1)</i>;

  #F7E9E5:veredito por item
  <i>StatusConciliacaoEnum — outro vocabulário</i>
   0  CONFERIDO
  10  PRECO_ACIMA
  11  PRECO_ABAIXO
  20  SEM_REFERENCIA_ITEM
  21  UNIDADE_DIVERGENTE;
}

stop

legend bottom
  |= |= |
  | + | INSERT |
  | ~ | UPDATE |
  | % | percent_exec em **processo** ao fim da etapa |
  --
  **Ciclo de vida do caso** (StatusExecEnum)
  10 PENDENTE · 11 EM_ANDAMENTO · 12 AGUARDANDO_RESPOSTA
  0 FINALIZADO · 1 FINALIZADO_COM_ALERTA
  20 ENCERRADO_SEM_COTACAO · 50-59 erro técnico
  --
  **Se a etapa falha:** grava o cod_status 50-59 e a mensagem.
  O //percent_exec// não avança. Só caso que em algum momento
  errou (**cod_status BETWEEN 50 AND 59**) volta para a fila
  de reprocesso — lida direto de **processo**, sem view.
endlegend

@enduml
